        async function apiUpsertStudentRecord(record) {
            const base = getApiBase();
            if (base && state.backendMode !== "standalone") {
                try {
                    const res = await fetch(`${base}/api/records`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(record)
                    });
                    if (res.ok) {
                        const json = await res.json();
                        return json.record || record;
                    }
                } catch (e) {}
            }
            const list = loadFallbackCache();
            const idx = list.findIndex(r => r.docId === record.docId);
            if (idx >= 0) list[idx] = record;
            else list.push(record);
            saveFallbackCache(list);
            return record;
        }

        async function apiFetchSingleRecord(docId) {
            const base = getApiBase();
            if (base && state.backendMode !== "standalone") {
                try {
                    const res = await fetch(`${base}/api/records/${encodeURIComponent(docId)}`, { cache: "no-store" });
                    if (res.ok) {
                        const json = await res.json();
                        return json.record || null;
                    }
                } catch (e) {}
            }
            return loadFallbackCache().find(r => r.docId === docId) || null;
        }

        async function apiFetchAllRecords() {
            const base = getApiBase();
