        function renderAdminDashboard() {
            const records = state.allStudentRecords;
            const totalStudents = records.length;
            const completedCount = records.filter(r => r.status === "Completed").length;

            let sumPct = 0;
            const missCounts = {};

            records.forEach(r => {
                const sc = computeScores(r);
                r.score1A = sc.s1a;
                r.score1B = sc.s1b;
                r.score2 = sc.s2;
                r.totalScore = sc.total;
                sumPct += (sc.total / 30) * 100;

                if (r.status === "Completed") {
                    PART1A_ITEMS.forEach(it => {
                        if (!(it.id in (r.part1a || {})) || r.part1a[it.id] !== it.ans) {
                            missCounts[`Item #${it.id}`] = (missCounts[`Item #${it.id}`] || 0) + 1;
                        }
                    });
                    PART1B_ITEMS.forEach(it => {
                        if (!arraysEqual((r.part1bSel || {})[it.id], it.ans)) {
                            missCounts[`Item #${it.id}`] = (missCounts[`Item #${it.id}`] || 0) + 1;
                        }
                    });
                    PART2_ITEMS.forEach(it => {
                        if (!arraysEqual((r.part2Sel || {})[it.id], it.ans)) {
                            missCounts[`Item #${it.id}`] = (missCounts[`Item #${it.id}`] || 0) + 1;
                        }
                    });
                }
            });

            const avgPercent = totalStudents ? Math.round(sumPct / totalStudents) : 0;
            let hardestLabel = "No misses yet";
            let maxMiss = 0;
            Object.entries(missCounts).forEach(([k, v]) => {
                if (v > maxMiss) {
                    maxMiss = v;
                    hardestLabel = `${k} (${v}x)`;
                }
            });

            document.getElementById("kpi-total-students").textContent = totalStudents;
            document.getElementById("kpi-completed-count").textContent = completedCount;
            document.getElementById("kpi-class-average").textContent = `${avgPercent}%`;
            document.getElementById("kpi-hardest-item").textContent = hardestLabel;

            renderAdminTable();
        }

        function renderAdminTable() {
            const tbody = document.getElementById("admin-students-tbody");
            const emptyState = document.getElementById("admin-empty-state");
            const query = (document.getElementById("admin-search-input").value || "").toLowerCase().trim();
            const statusFilter = document.getElementById("admin-status-filter").value;
            const sortBy = document.getElementById("admin-sort-select").value;

            let filtered = state.allStudentRecords.filter(rec => {
