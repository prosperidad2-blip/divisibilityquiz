        function arraysEqual(a, b) {
            const sa = (a || []).slice().sort((x, y) => x - y);
            const sb = (b || []).slice().sort((x, y) => x - y);
            return sa.length === sb.length && sa.every((val, idx) => val === sb[idx]);
        }

        function computeScores(stu) {
            let s1a = 0;
            PART1A_ITEMS.forEach(it => {
                if (it.id in (stu.part1a || {}) && stu.part1a[it.id] === it.ans) s1a++;
            });

            let s1b = 0;
            PART1B_ITEMS.forEach(it => {
                const sel = (stu.part1bSel || {})[it.id];
                if (sel && sel.length > 0 && arraysEqual(sel, it.ans)) s1b++;
            });

            let s2 = 0;
            PART2_ITEMS.forEach(it => {
                const sel = (stu.part2Sel || {})[it.id];
                if (sel && sel.length > 0 && arraysEqual(sel, it.ans)) s2++;
            });

            return { s1a, s1b, s2, total: s1a + s1b + s2 };
        }

        function getAnsweredCounts(stu) {
            const c1a = PART1A_ITEMS.filter(it => it.id in (stu.part1a || {})).length;
            const c1b = PART1B_ITEMS.filter(it => ((stu.part1bSel || {})[it.id] || []).length > 0).length;
            const c2 = PART2_ITEMS.filter(it => ((stu.part2Sel || {})[it.id] || []).length > 0).length;
            return { c1a, c1b, c2, total: c1a + c1b + c2 };
        }

