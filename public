                    if (res.ok) {
                        const json = await res.json();
                        if (Array.isArray(json.records)) {
                            state.allStudentRecords = json.records;
                            return;
                        }
                    }
                } catch (e) {}
            }
            state.allStudentRecords = loadFallbackCache();
