# Server Port (Render automatically injects PORT)
PORT=3000

# Teacher / Admin Dashboard PIN
ADMIN_PIN=1234

# Firestore Collection Name (keeps data persistent across Render redeploys)
FIRESTORE_COLLECTION=aral_math_g6_w4_records

# Firebase Admin Service Account JSON (paste minified single-line JSON string on Render)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Optional Base64-encoded Service Account JSON (alternative to raw JSON)
# FIREBASE_SERVICE_ACCOUNT_BASE64=