        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
        }

        function detectDeviceLabel() {
            const ua = navigator.userAgent || "";
            let type = "Laptop/PC";
            if (/iPad|Tablet|PlayBook|Silk/i.test(ua)) type = "Tablet";
            else if (/Mobile|Android|iPhone|iPod/i.test(ua)) type = "Mobile";
