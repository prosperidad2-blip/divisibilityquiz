        let syncDebounceTimer = null;

        function updateActiveStudent(mutator) {
            const stu = state.activeStudent;
            if (!stu) return;
            mutator(stu);
            const sc = computeScores(stu);
            stu.score1A = sc.s1a;
            stu.score1B = sc.s1b;
