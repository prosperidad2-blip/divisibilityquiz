                const ok = sel.length > 0 && arraysEqual(sel, it.ans);
                rows.push(`
                    <div class="p-3.5 rounded-2xl border ${ok ? "bg-emerald-50/70 border-emerald-200" : "bg-rose-50/70 border-rose-200"}">
