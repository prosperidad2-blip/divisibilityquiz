                    badge.className = "text-[11px] font-bold bg-amber-100 text-amber-800 px-2.5 py-0.5 rounded-full";
                }
                return;
            }

            try {
                const res = await fetch(`${base}/api/health`, { cache: "no-store" });
                if (!res.ok) throw new Error("Health endpoint unavailable");
                const data = await res.json();
                state.backendMode = data.storage === "firestore" ? "firestore" : "memory";

                if (state.backendMode === "firestore") {
                    if (pill) pill.innerHTML = `<i class="fa-solid fa-cloud-check text-emerald-600 mr-1"></i> Firestore Connected`;
