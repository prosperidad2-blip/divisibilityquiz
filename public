        // ==================== TONE.JS SOUND EFFECTS ====================
        let sfxSynth = null;
        let sfxPolySynth = null;

        async function ensureAudioReady() {
            if (!state.soundEnabled || typeof Tone === "undefined") return false;
            try {
                if (Tone.context.state !== "running") await Tone.start();
                if (!sfxSynth) {
                    sfxSynth = new Tone.Synth({
                        oscillator: { type: "triangle" },
                        envelope: { attack: 0.01, decay: 0.12, sustain: 0.02, release: 0.15 }
                    }).toDestination();
                    sfxSynth.volume.value = -8;
                }
                if (!sfxPolySynth) {
                    sfxPolySynth = new Tone.PolySynth(Tone.Synth, {
                        oscillator: { type: "sine" },
                        envelope: { attack: 0.015, decay: 0.2, sustain: 0.05, release: 0.35 }
                    }).toDestination();
                    sfxPolySynth.volume.value = -8;
                }
                return true;
            } catch (e) {
                return false;
            }
        }

        async function playSound(type) {
            if (!state.soundEnabled) return;
            const ready = await ensureAudioReady();
            if (!ready) return;
            const now = Tone.now();
            try {
                switch (type) {
                    case "click": sfxSynth.triggerAttackRelease("C5", "32n", now); break;
                    case "selectYes": sfxSynth.triggerAttackRelease("E5", "24n", now); break;
                    case "selectNo": sfxSynth.triggerAttackRelease("C5", "24n", now); break;
                    case "toggleOn": sfxSynth.triggerAttackRelease("G5", "32n", now); break;
                    case "toggleOff": sfxSynth.triggerAttackRelease("D5", "32n", now); break;
                    case "stage":
                        sfxSynth.triggerAttackRelease("E5", "32n", now);
                        sfxSynth.triggerAttackRelease("A5", "24n", now + 0.07);
                        break;
                    case "register":
                        sfxPolySynth.triggerAttackRelease(["C5", "E5", "G5"], "16n", now);
                        break;
                    case "submitHigh":
                        sfxPolySynth.triggerAttackRelease(["C5", "E5", "G5"], "16n", now);
                        sfxPolySynth.triggerAttackRelease(["E5", "G5", "C6"], "8n", now + 0.16);
                        break;
                    case "submitComplete":
                        sfxPolySynth.triggerAttackRelease(["C5", "G5"], "16n", now);
                        sfxPolySynth.triggerAttackRelease(["E5", "A5"], "8n", now + 0.14);
                        break;
                    case "error":
                        sfxSynth.triggerAttackRelease("G3", "16n", now);
                        sfxSynth.triggerAttackRelease("F#3", "16n", now + 0.09);
                        break;
                    case "logout":
                        sfxSynth.triggerAttackRelease("G4", "32n", now);
                        sfxSynth.triggerAttackRelease("C4", "24n", now + 0.08);
                        break;
                }
            } catch (e) {}
        }

