            document.getElementById("prog-stage-1").textContent = `${counts.c1a}/10 answered`;
            document.getElementById("prog-stage-2").textContent = `${counts.c1b}/10 answered`;
            document.getElementById("prog-stage-3").textContent = `${counts.c2}/10 answered`;
            document.getElementById("tab-stage-4-title").textContent = isCompleted ? "🏆 Results & Key" : "📝 Review & Submit";
