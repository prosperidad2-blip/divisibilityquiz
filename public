                await apiUpsertStudentRecord(stu);
                document.getElementById("stu-sync-status").textContent =
                    `● Saved to ${state.backendMode === "firestore" ? "Firestore" : "Server"} (${new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })})`;
