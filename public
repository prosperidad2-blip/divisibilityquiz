        function setStage(stageNum) {
            if (state.stage !== stageNum) playSound("stage");
            state.stage = stageNum;
            [1, 2, 3, 4].forEach(n => {
                const el = document.getElementById(`stage-${n}-container`);
                const tab = document.getElementById(`tab-stage-${n}`);
                if (n === stageNum) {
