        function loadFallbackCache() {
            try {
                const raw = localStorage.getItem(FALLBACK_CACHE_KEY);
                const parsed = raw ? JSON.parse(raw) : [];
                return Array.isArray(parsed) ? parsed : [];
            } catch (e) {
                return [];
            }
        }

        function saveFallbackCache(list) {
            try {
                localStorage.setItem(FALLBACK_CACHE_KEY, JSON.stringify(list));
            } catch (e) {}
        }

        async function checkBackendHealth() {
            const base = getApiBase();
            const pill = document.getElementById("backend-health-pill");
            const badge = document.getElementById("admin-sync-badge");
            if (!base) {
                state.backendMode = "standalone";
                if (pill) pill.innerHTML = `<i class="fa-solid fa-laptop-code text-amber-500 mr-1"></i> Preview Mode (Download ZIP for Render)`;
